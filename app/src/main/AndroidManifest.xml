<?xml version="1.0" encoding="utf-8"?>
<!--
  SrunAutoLogin AndroidManifest。

  权限台账（N4/B9：只留必要项）：
    本任务（后台调度）新增：
      - RECEIVE_BOOT_COMPLETED   ← 开机自启（B4 触发点 1）
    既有：
      - INTERNET / ACCESS_NETWORK_STATE  （认证客户端 + 网络状态判断，上一任务）
      - ACCESS_WIFI_STATE / CHANGE_WIFI_STATE / ACCESS_FINE_LOCATION / NEARBY_WIFI_DEVICES（WiFi 感知，上一任务）
  **明确不加**：AccessibilityService（BIND_ACCESSIBILITY_SERVICE）、悬浮窗（SYSTEM_ALERT_WINDOW）、
  QUERY_ALL_PACKAGES、READ_CALL_LOG / READ_SMS / READ_CONTACTS、POST_NOTIFICATIONS
  （本版本不发送任何通知，故不申请；理由见 artifacts/android-ci/ci-report.md）。
  【morning1 任务新增（用户新需求：常驻通知 + 每日 6:00 精确唤醒）】
      - POST_NOTIFICATIONS             ← API 33+ 显示常驻通知的运行时权限（启用开关时申请，被拒则界面提示）
      - FOREGROUND_SERVICE             ← 前台服务通用权限（API 28+ 必需）
      - FOREGROUND_SERVICE_DATA_SYNC   ← 前台服务类型权限（API 34+ 强制：类型与权限必须同时声明）
      - SCHEDULE_EXACT_ALARM           ← API 31+ 精确闹钟（用户可在系统「闹钟与提醒」里关闭；
                                           未授权时降级为 setAndAllowWhileIdle 并记日志，不静默失败）
  【前台服务类型选择依据】dataSync：本服务只做「与服务器同步登录状态」的常驻通知；
     不用 specialUse（需额外 <property> 子类型声明 + Play 人工审核，本应用完全可用标准类型），
     不用 shortService（约 3 分钟上限，与「待机时常驻通知」冲突）。详见 work/MorningAuthForegroundService.kt 的类注释。

  明文 HTTP（crashfix1 任务 B）：
    targetSdk = 36 → Android 9（API 28）起 cleartextTrafficPermitted 默认 false。SRun 门户是纯 http://
    （无 TLS），**不修则「立即登录」必被系统拦掉**（cleartext HTTP traffic not permitted）。
    这里**不**用全局 android:usesCleartextTraffic="true"，而用最小范围的 network security config：
    只放行校内 Portal 的两个目标（见 res/xml/network_security_config.xml），其余保持默认拒绝。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 本任务新增（B4 触发点 1：开机自启） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 既有：联网与网络状态 -->
    <!-- morning1 任务新增：常驻通知 + 前台服务 + 精确闹钟 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 既有：联网与网络状态 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 既有：WiFi 感知层（net/ + platform/ 包） -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <application
        android:name="top.ytu.srunautologin.App"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
          view-fix2（真机反馈：界面长、顶部输入框够不着）：
            android:windowSoftInputMode="adjustResize" —— 软键盘弹出时「压缩窗口高度」而不是「整体上推内容」。
            选 adjustResize 而不是 adjustPan 的理由：adjustPan 会把整个窗口内容向上顶来保证焦点可见，
            界面本身就比屏幕长，被顶上去后**顶部控件的坐标会被顶出可视区**（正是用户说的「『密码』以上不能访问」），
            而 ScrollView 的长度不变 → 顶部仍不可达；adjustResize 缩短 ScrollView 的可视高度，
            内容仍可滚动，配合下面布局里的 focusable + onCreate 里回到顶部，任何输入框都能滑出来。
          主题 parent=@android:style/Theme.Material.Light（非 Fullscreen）→ adjustResize 正常生效。
        -->
        <activity
            android:name="top.ytu.srunautologin.ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          B4 触发点 1：开机自启。
          BOOT_COMPLETED / LOCKED_BOOT_COMPLETED / MY_PACKAGE_REPLACED 属于 Android 7+ 隐式广播
          限制的**豁免清单**，可以静态注册。
          exported 显式声明为 true：这三个广播由系统/系统组件发出，必须可被外部（系统）投递。
        -->
        <receiver
            android:name="top.ytu.srunautologin.work.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          B4 触发点 3：周期保底 + 退避重试的执行体（JobScheduler 方案）。
          exported="false" + BIND_JOB_SERVICE 权限 → 只有系统能启动；external 服务由系统调度。
        -->
        <service
            android:name="top.ytu.srunautologin.work.AuthJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
          morning1：常驻通知的前台服务（用户要求「应用在后台待机时推送常驻通知」）。
          - exported=false：只允许本应用启动；
          - foregroundServiceType="dataSync"：API 34+ 必须显式声明类型，且类型权限
            FOREGROUND_SERVICE_DATA_SYNC 已在上方声明；
          - 本服务**不做认证**，只负责「常驻通知 + 存活」；认证仍由 AuthJobService 执行。
        -->
        <service
            android:name="top.ytu.srunautologin.work.MorningAuthForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          morning1：每日 06:00 / +10 分钟重试闹钟的回调。
          exported=false：只接收本应用自己发的 PendingIntent（不需要外部投递）。
        -->
        <receiver
            android:name="top.ytu.srunautologin.work.MorningAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
          注意（Android 7+ 隐式广播限制）：CONNECTIVITY_ACTION **不在**豁免清单里，
          静态注册收不到，因此这里**故意不注册** NetworkChangeReceiver；
          改由 App.onCreate 动态注册（Context.RECEIVER_NOT_EXPORTED）+ NetworkCallback 实现（B4 触发点 2）。
        -->

    </application>

</manifest>
