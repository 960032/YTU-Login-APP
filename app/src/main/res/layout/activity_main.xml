<?xml version="1.0" encoding="utf-8"?>
<!-- 配置界面布局：全部使用系统原生 View，不引入 Compose 或任何第三方 UI 库 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fadeScrollbars="false"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:scrollbarStyle="insideInset"
    android:scrollbars="vertical"
    android:paddingEnd="4dp"
    android:paddingRight="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_config"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 元素 1：账号输入框 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_username" />

        <EditText
            android:id="@+id/edit_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_username"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLines="1" />

        <!-- 元素 2：密码输入框（textPassword） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_password" />

        <EditText
            android:id="@+id/edit_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_password"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:maxLines="1" />

        <!-- 元素 3：登录方式二选一 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_carrier" />

        <Spinner
            android:id="@+id/spinner_carrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 元素 4：备注名 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_label" />

        <EditText
            android:id="@+id/edit_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_label"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLines="1" />

        <!-- 元素 5：WiFi 选择区 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_wifi" />

        <Button
            android:id="@+id/btn_use_current_wifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_use_current_wifi" />

        <!-- 元素 5b（uifix2 任务 C-1）：用户要求「将选择wifi功能做进弹出窗口，添加可点击的『选择列表』按钮」。
             点击 → 刷新已识别 WiFi 列表 → 弹出**单选**对话框供选择（android.app.AlertDialog，零第三方依赖）。
             原有 ssid_list 容器保留（id 与位置不变，元素 5 的必需 id），但不再渲染可勾选列表：
             它现在只显示「当前选择：<ssid>」与降级/空列表提示（理由见 artifacts/uifix2/fix-report.md 任务 C-1）。 -->
        <Button
            android:id="@+id/btn_choose_wifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_choose_wifi" />

        <LinearLayout
            android:id="@+id/ssid_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <EditText
            android:id="@+id/edit_new_ssid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_new_ssid"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLines="1" />

        <!-- 元素 6：权限说明与申请。
             说明（text_permission_notice）与状态（text_permission_state）拆成两个独立 TextView：
             说明是固定解释性文案，状态随「已授权 / 未授权 / 降级」变化并**由代码按状态着色**
             （绿=已授权，红=未授权）。两者之间用一条 1dp 分隔线 + 上下留白隔开，避免糊成一团。 -->
        <TextView
            android:id="@+id/text_permission_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/permission_not_shown"
            android:textColor="@color/permission_notice_text" />

        <!-- 说明与状态的间隔：留白 + 细横线，保证「一眼分得清哪行是说明、哪行是状态」 -->
        <View
            android:id="@+id/divider_permission"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/permission_divider" />

        <TextView
            android:id="@+id/text_permission_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_state_unknown"
            android:textColor="@color/permission_state_denied_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_request_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_request_permission" />

        <!-- 元素 7：保存 -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_save" />

        <!-- 元素 8：状态显示区（成功/失败原因/时间，失败不静默） -->
        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_initial" />

        <!-- 元素 9：立即登录 -->
        <Button
            android:id="@+id/btn_login_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_login_now" />

        <!-- 元素 10：Portal（门户）地址 —— 不同校区地址不同，用户可自行输入并保存（持久化，优先于代码默认值）。
             追加在末尾（index=10），原有 1..9 元素的顺序与编号一律不变。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_portal" />

        <EditText
            android:id="@+id/edit_portal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_portal"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1" />

        <!-- 元素 10b（uifix2 任务 C-2）：Portal 地址**常驻状态**显示（用户原话：
             未保存则使用红色字体显示「尚未保存地址」，保存则用绿色字体显示「已保存portal:<地址>」）。
             颜色/文案在运行时由代码按「存储里是否真的有这个键」覆写（MainActivity.renderPortalStatus），
             XML 这里只给初始值（红 + 「尚未保存地址」）。 -->
        <TextView
            android:id="@+id/text_portal_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/portal_status_unsaved"
            android:textColor="@color/portal_status_unsaved_text"
            android:textStyle="bold" />

        <!-- ================= 元素 11：早上自动登录（morning1 任务）=================
             用户要求：①「点击(启用/停用)自动登录」启停开关；②权限描述文本
             「登录任务需要自启动权限，该权限用于每天早上的自动唤起。」+ 一键跳转系统设置。
             控件全部为系统原生 View（无 androidx/Compose），与既有界面风格一致。 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="@color/permission_divider" />

        <Button
            android:id="@+id/btn_toggle_auto_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/btn_toggle_auto_login" />

        <TextView
            android:id="@+id/text_morning_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/morning_status_disabled"
            android:textColor="@color/permission_notice_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/text_autostart_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/morning_autostart_notice"
            android:textColor="@color/permission_notice_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_open_autostart_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/morning_btn_open_autostart" />

        <Button
            android:id="@+id/btn_save_portal"            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_save_portal" />

    </LinearLayout>
</ScrollView>
