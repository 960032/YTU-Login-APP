<?xml version="1.0" encoding="utf-8"?>
<!-- 配置界面布局：全部使用系统原生 View，不引入 Compose 或任何第三方 UI 库 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fadeScrollbars="false"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:scrollbarStyle="insideInset"
    android:scrollbars="vertical"
    android:paddingEnd="4dp"
    android:paddingRight="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_config"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 元素 1：账号输入框 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_username" />

        <EditText
            android:id="@+id/edit_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_username"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLines="1" />

        <!-- 元素 2：密码输入框（textPassword） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_password" />

        <EditText
            android:id="@+id/edit_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_password"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:maxLines="1" />

        <!-- 元素 3：登录方式二选一 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_carrier" />

        <Spinner
            android:id="@+id/spinner_carrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 元素 4：备注名 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_label" />

        <EditText
            android:id="@+id/edit_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_label"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLines="1" />

        <!-- 元素 5：WiFi 选择区 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_wifi" />

        <Button
            android:id="@+id/btn_use_current_wifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_use_current_wifi" />

        <!-- 元素 5b（uifix2 任务 C-1）：用户要求「将选择wifi功能做进弹出窗口，添加可点击的『选择列表』按钮」。
             点击 → 刷新已识别 WiFi 列表 → 弹出**单选**对话框供选择（android.app.AlertDialog，零第三方依赖）。
             原有 ssid_list 容器保留（id 与位置不变，元素 5 的必需 id），但不再渲染可勾选列表：
             它现在只显示「当前选择：<ssid>」与降级/空列表提示（理由见 artifacts/uifix2/fix-report.md 任务 C-1）。 -->
        <Button
            android:id="@+id/btn_choose_wifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_choose_wifi" />

        <!-- 元素 12（accountsel1 任务）：用户要求「添加账号选择按钮，类似于已添加的 wifi 选择，
             点击后弹出弹框」。因此按钮放在「选择列表」（WiFi 选择）旁边；点击 → 弹出自建多选列表
             （勾选框 + 账户 + 网络 + 蓝色「删除」），实现见 MainActivity.chooseAccountFromDialog()。 -->
        <Button
            android:id="@+id/btn_choose_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_choose_account" />

        <LinearLayout
            android:id="@+id/ssid_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <EditText
            android:id="@+id/edit_new_ssid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_new_ssid"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLines="1" />

        <!-- 元素 7：保存 -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_save" />

        <!-- 说明与状态的间隔：留白 + 细横线，保证「一眼分得清哪行是说明、哪行是状态」 -->
        <View
            android:id="@+id/divider_permission"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/permission_divider" />

        <!-- ===== 元素 11（restoretoggle1 恢复）：后台自动登录的「控制开关 + 状态文本」 =====
             位置即 removemorning1 删除前的原位置（保持「与「选择列表」相邻」的原有排布习惯）。
             用户逐字要求：
                · 按钮文案 =「点击切换自动登录状态」；
                · 状态文本**在按钮上方（紧邻上一行）**：启用 = 绿色「自动登录已启用」、停用 = 红色「自动登录已停用」。
             颜色**由代码按状态设置**（MainActivity.renderAutoLoginStatus → applyStateColor），
             XML 这里只给初始值（默认启用 ⇒ 绿 + 「自动登录已启用」）。
             默认启用 = AutoLoginSwitch.DEFAULT_ENABLED（新键 srun_auto_login_enabled_v1 首次缺省）；
             恢复历史：removemorning1 曾整块删除本元素（当时只要求删「6:00 定时+闹钟」，控件被连带删除）。 -->
        <TextView
            android:id="@+id/text_auto_login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/auto_login_status_enabled"
            android:textColor="@color/auto_login_status_enabled_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_toggle_auto_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_toggle_auto_login" />

        <TextView
            android:id="@+id/text_permission_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_state_unknown"
            android:textColor="@color/permission_state_denied_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_request_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_request_permission" />

        <!-- 元素 8：状态显示区（成功/失败原因/时间，失败不静默） -->
        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_initial" />

        <!-- 元素 9：立即登录 -->
        <Button
            android:id="@+id/btn_login_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_login_now" />

        <!-- 元素 10：Portal（门户）地址 —— 不同校区地址不同，用户可自行输入并保存（持久化，优先于代码默认值）。
             追加在末尾（index=10），原有 1..9 元素的顺序与编号一律不变。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_portal" />

        <EditText
            android:id="@+id/edit_portal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_portal"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1" />

        <!-- 元素 10b（uifix2 任务 C-2）：Portal 地址**常驻状态**显示（用户原话：
             未保存则使用红色字体显示「尚未保存地址」，保存则用绿色字体显示「已保存portal:<地址>」）。
             颜色/文案在运行时由代码按「存储里是否真的有这个键」覆写（MainActivity.renderPortalStatus），
             XML 这里只给初始值（红 + 「尚未保存地址」）。 -->
        <TextView
            android:id="@+id/text_portal_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/portal_status_unsaved"
            android:textColor="@color/portal_status_unsaved_text"
            android:textStyle="bold" />

        <!-- restoretoggle1（用户要求「恢复控制开关」）：元素 11 的**开关按钮 + 状态文本**已在上方恢复；
             「自启动权限说明文本 / 前往系统设置开启自启动」**按用户要求不恢复**——那属于开机广播场景，
             用户明确接受「手机重启后最多等 15 分钟」，本次不恢复开机广播，因此自启动说明无意义。
             其余控件（账号、密码、登录方式、备注名、WiFi 选择、权限、保存、状态区、立即登录、
             Portal、账号选择、日志）一律保留。 -->

        <Button
            android:id="@+id/btn_save_portal"            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_save_portal" />

        <!-- ================= 元素 13：日志（logfix1 任务 D 段）=================
             用户要求：在界面**最下侧**添加「日志」按钮，点击后打开日志窗口（记录本应用执行与用户输入的所有操作）。
             因此本按钮是布局里**最后一个**控件（在所有既有元素之下）。弹窗实现见 MainActivity.showLogDialog()：
             可滚动 + 复制全部 + 清空，零第三方依赖（android.app.AlertDialog + ScrollView + TextView）。 -->
        <Button
            android:id="@+id/btn_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/btn_log" />

    </LinearLayout>
</ScrollView>
