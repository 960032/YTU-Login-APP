<?xml version="1.0" encoding="utf-8"?>
<!-- 配置界面布局：全部使用系统原生 View，不引入 Compose 或任何第三方 UI 库 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_config"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 元素 1：账号输入框 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_username" />

        <EditText
            android:id="@+id/edit_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_username"
            android:inputType="text"
            android:maxLines="1" />

        <!-- 元素 2：密码输入框（textPassword） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_password" />

        <EditText
            android:id="@+id/edit_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_password"
            android:inputType="textPassword"
            android:maxLines="1" />

        <!-- 元素 3：登录方式二选一 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_carrier" />

        <Spinner
            android:id="@+id/spinner_carrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 元素 4：备注名 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_label" />

        <EditText
            android:id="@+id/edit_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_label"
            android:inputType="text"
            android:maxLines="1" />

        <!-- 元素 5：WiFi 选择区 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_wifi" />

        <Button
            android:id="@+id/btn_use_current_wifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_use_current_wifi" />

        <LinearLayout
            android:id="@+id/ssid_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <EditText
            android:id="@+id/edit_new_ssid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_new_ssid"
            android:inputType="text"
            android:maxLines="1" />

        <!-- 元素 6：权限说明与申请 -->
        <TextView
            android:id="@+id/text_permission_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/permission_not_shown"
            android:textColor="#FF6D00" />

        <Button
            android:id="@+id/btn_request_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_request_permission" />

        <!-- 元素 7：保存 -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_save" />

        <!-- 元素 8：状态显示区（成功/失败原因/时间，失败不静默） -->
        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_initial" />

        <!-- 元素 9：立即登录 -->
        <Button
            android:id="@+id/btn_login_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_login_now" />

    </LinearLayout>
</ScrollView>
