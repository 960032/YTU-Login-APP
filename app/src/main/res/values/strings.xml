<?xml version="1.0" encoding="utf-8"?>
<!-- 界面文案：集中声明，便于离线核对界面元素是否具备（见 ui/UiSpec.kt） -->
<resources>
    <!-- app 名称：中性命名，不含任何个人信息 -->
    <string name="app_name">SRun 自动登录</string>

    <string name="title_config">登录配置</string>

    <!-- 元素 1：账号 -->
    <string name="label_username">账号</string>
    <!-- uifix2（任务 C-3）：用户逐字要求的文案。注意用户写的是「登**陆**账户」（非「登录」），逐字采用。 -->
    <string name="hint_username">登录账户</string>

    <!-- 元素 2：密码 -->
    <string name="label_password">密码</string>
    <string name="hint_password">登录密码</string>

    <!-- 元素 3：登录方式 -->
    <string name="label_carrier">登录方式</string>

    <!-- 元素 4：备注名 -->
    <string name="label_label">备注名</string>
    <string name="hint_label">用于区分多个账号，如「中国移动」</string>

    <!-- 元素 5：WiFi 选择 -->
    <string name="label_wifi">WiFi 选择</string>
    <string name="btn_use_current_wifi">使用当前连接 wifi</string>
    <!-- uifix2（任务 C-3）：用户逐字要求：原「或手动输入 WiFi 名称」→「输入wifi名称」 -->
    <string name="hint_new_ssid">输入wifi名称</string>
    <!-- 元素 5b（uifix2 任务 C-1）：用户要求「将选择wifi功能做进弹出窗口，添加可点击的『选择列表』按钮」 -->
    <string name="btn_choose_wifi">选择列表</string>
    <string name="dialog_wifi_title">选择 WiFi</string>
    <string name="dialog_cancel">取消</string>
    <!-- 元素 5 原地保留的「当前选择」摘要行（列表改为弹窗后，原地只说明现在选中的是哪个） -->
    <string name="ssid_selected_none">尚未选择网络</string>
    <string name="ssid_selected_current">当前选择：%1$s</string>
    <string name="ssid_list_count">已识别 %1$d 个网络</string>
    <!-- WiFi 列表长度上限（insets-fix1 / B：周边 WiFi 可能上百个，全部渲染会把下方控件推得极远） -->
    <string name="ssid_list_more">还有 %1$d 个未显示</string>

    <!-- 元素 6：权限说明与申请 -->
    <string name="btn_request_permission">申请「位置信息」权限</string>
    <string name="permission_explain_title">权限用途说明</string>
    <string name="permission_grant_ok">同意并申请</string>
    <string name="permission_grant_cancel">未授权,仅访问当前网络</string>
    <string name="permission_not_shown">未授权,仅访问当前网络</string>
    <string name="degraded_prefix">当前处于降级状态</string>
    <string name="degraded_no_list">未授权位置信息,仅访问当前网络</string>
    <!-- wifi-fix1（B）：权限已授予但系统读不到 WiFi 信息时，列表区的显式提示（指向系统「位置信息」总开关） -->
    <string name="ssid_list_empty_no_data">不能访问网络列表,请确认定位开关已开启，并确认本应用已开启精确位置权限</string>

    <!-- 元素 6 的状态行（与说明分开显示，颜色由代码按状态设置） -->
    <string name="permission_state_unknown">未授权</string>
    <string name="permission_state_granted">已授权</string>
    <string name="permission_state_denied">WiFi 权限：未授权（需「位置信息」权限）</string>
    <string name="permission_state_degraded_suffix">不完整权限</string>
    <string name="permission_notice_common">该「位置信息」权限用于读取 WiFi 名称（Android 规定 WiFi 名称属于位置信息），以便自动登录到校园网；不同意时仍可登录已连接的 WiFi。</string>

    <!-- 元素 7：保存 -->
    <string name="btn_save">保存账号与 WiFi 绑定</string>
    <string name="save_done">已保存：%1$s ↔ %2$s</string>

    <!-- 元素 8：状态区 -->
    <string name="status_initial">尚未登录</string>

    <!-- 元素 9：立即登录（uifix2 任务 A：认证链路在后台线程执行，点击后状态区先给「正在登录」反馈） -->
    <string name="btn_login_now">立即登录</string>
    <string name="login_running">正在登录…</string>
    <string name="login_failed_prefix">登录失败：</string>

    <!-- 元素 10：Portal（门户）地址（不同校区地址不同，可自行输入并保存）
         uifix2（任务 C-3）：用户逐字要求：原「Portal地址(校园网门户,按校区填写)」→「网络门户地址」 -->
    <string name="label_portal">网络门户地址</string>
    <string name="hint_portal">如 202.194.116.116</string>
    <string name="btn_save_portal">保存门户地址</string>
    <string name="save_portal_done">已保存门户地址：%1$s</string>
    <!-- 元素 10b（uifix2 任务 C-2）：Portal 地址常驻状态显示。
         未保存 = 红（#FFC62828）显示「尚未保存地址」；已保存 = 绿（#FF2E7D32）显示「已保存portal:<地址>」
         ——「portal:」小写、冒号后无空格，逐字按用户给的格式。 -->
    <string name="portal_status_unsaved">尚未保存地址</string>
    <string name="portal_status_saved">已保存portal:%1$s</string>

    <!-- 元素 6 的配色引用（代码按状态覆写：未授权=红、已授权=绿；此处仅作初始值） -->
    <color name="permission_state_granted_text">#FF2E7D32</color>
    <color name="permission_state_denied_text">#FFC62828</color>
    <!-- 降级态单列一色（琥珀 #F57F17），使它既不与「未授权=红」也不与「已授权=绿」混淆 -->
    <color name="permission_state_degraded_text">#FFF57F17</color>
    <color name="permission_notice_text">#FF616161</color>
    <color name="permission_divider">#FFE0E0E0</color>
    <!-- 元素 10b（uifix2）：Portal 常驻状态的初始配色（运行时由代码按「是否真的保存过」覆写） -->
    <color name="portal_status_unsaved_text">#FFC62828</color>
    <color name="portal_status_saved_text">#FF2E7D32</color>

    <!-- ================= 元素 11：早上自动登录（morning1 任务）================= -->
    <!-- 启停开关：**逐字**采用用户要求「点击(启用/停用)自动登录」（半角括号，逐字不改） -->
    <string name="btn_toggle_auto_login">点击切换自动登录状态</string>
    <!-- 开关状态行：按钮文案逐字不变，另用一行明确显示当前是启用还是停用 -->
    <string name="morning_status_enabled">自动登录：已启用（每天 06:00 起每 10 分钟尝试一次，最多 7 次，07:00 截止）</string>
    <string name="morning_status_disabled">自动登录：已停用（后台任务不会执行）</string>
    <!-- 权限描述文本：**逐字**采用用户要求 -->
    <string name="morning_autostart_notice">登录任务需要自启动权限，该权限用于每天早上的自动唤起。</string>
    <string name="morning_btn_open_autostart">前往系统设置开启自启动</string>
    <string name="morning_toast_autostart_ok">已跳转到系统的自启动管理页</string>
    <string name="morning_toast_autostart_fallback">未找到本机机型的「自启动管理」页面，已改为打开应用详情页：请在此页面手动开启「自启动」与「后台弹出界面」</string>
    <string name="morning_toast_notification_denied">通知被禁用：无法显示工作状态</string>
    <string name="morning_notification_no_account">（尚未保存账号）</string>
    <string name="morning_notification_no_ssid">（尚未绑定 WiFi）</string>

    <!-- ================= 常驻通知：标题与内容**逐字**采用用户要求 ================= -->
    <!-- 标题：自动连接正在工作 -->
    <string name="morning_notification_title">自动连接正在工作</string>
    <!-- 内容：已保存登录账号:<账号名>,将登录网络:<网络名>（英文半角逗号；%1$s=账号名、%2$s=网络名） -->
    <string name="morning_notification_text">已保存登录账号:%1$s,将登录网络:%2$s</string>
    <string name="morning_channel_name">自动连接</string>
    <string name="morning_channel_desc">显示自动连接的工作状态</string>

    <!-- ================= 元素 12：账号选择（accountsel1 任务，用户原话）=================
         按钮「账号选择」→ 弹窗标题**逐字**「选择生效账号」；每行：勾选框 → 账户（偏左） → 网络（偏右） → 蓝色「删除」（最右）；
         删除确认框**逐字**「确认要删除<对应账户名称>和相应的<对应网络名称>吗?」（英文半角问号 '?'，逐字不改）。 -->
    <string name="btn_choose_account">账号选择</string>
    <string name="dialog_account_title">选择生效账号</string>
    <string name="account_empty">还没有保存的账号，请先在下方填写并保存</string>
    <string name="account_selected_count">已勾选 %1$d 个</string>
    <string name="account_delete">删除</string>
    <!-- 删除确认：%1$s=对应账户名称、%2$s=对应网络名称；问号是英文半角 '?'（用户原文如此） -->
    <string name="account_delete_confirm">确认要删除%1$s和相应的%2$s吗?</string>
    <!-- acctfix1（真机反馈）：删除成功的专用提示；%1$s=备注名(label)、%2$s=网络名(ssid)。
         只含 label 与 ssid，绝不带账号/密码；与 save_done（「已保存：…」）是两条独立文案。 -->
    <string name="account_delete_done">已删除：%1$s ↔ %2$s</string>

    <!-- ================= 元素 13：日志（logfix1 任务 D 段，用户原话「在界面最下侧添加『日志』按钮，
         点击后打开日志窗口」）=================
         按钮文案**逐字**「日志」；窗口标题建议值「运行日志」（派发指令给出的建议文案）。 -->
    <string name="btn_log">日志</string>
    <string name="log_dialog_title">运行日志</string>
    <string name="log_empty">暂无日志</string>
    <string name="log_copy_all">复制全部</string>
    <string name="log_clear">清空</string>
    <string name="log_clear_confirm">确认要清空全部日志吗?</string>
    <string name="log_copied">已复制 %1$d 条日志到剪贴板</string>
    <string name="log_copy_empty">暂无日志可复制</string>
    <!-- 日志窗口只渲染最近 N 条（1000 条一次性渲染会让低端机卡顿），全量仍可通过「复制全部」取到 -->
    <string name="log_showing_recent">当前显示最近 %1$d 条（共 %2$d 条，复制全部可取全量）</string>
    <string name="log_count">共 %1$d 条</string>
</resources>
