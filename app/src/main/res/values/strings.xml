<?xml version="1.0" encoding="utf-8"?>
<!-- 界面文案：集中声明，便于离线核对界面元素是否具备（见 ui/UiSpec.kt） -->
<resources>
    <!-- app 名称：中性命名，不含任何个人信息 -->
    <string name="app_name">SRun 自动登录</string>

    <string name="title_config">登录配置</string>

    <!-- 元素 1：账号 -->
    <string name="label_username">账号</string>
    <string name="hint_username">学号/手机号（不含 @ytu 后缀也可）</string>

    <!-- 元素 2：密码 -->
    <string name="label_password">密码</string>
    <string name="hint_password">登录密码</string>

    <!-- 元素 3：登录方式 -->
    <string name="label_carrier">登录方式</string>

    <!-- 元素 4：备注名 -->
    <string name="label_label">备注名</string>
    <string name="hint_label">用于区分多个账号，如「中国移动」</string>

    <!-- 元素 5：WiFi 选择 -->
    <string name="label_wifi">WiFi 选择</string>
    <string name="btn_use_current_wifi">用当前连接的 WiFi</string>
    <string name="hint_new_ssid">或手动输入 WiFi 名称</string>

    <!-- 元素 6：权限说明与申请 -->
    <string name="btn_request_permission">申请 WiFi 权限</string>
    <string name="permission_explain_title">权限用途说明</string>
    <string name="permission_grant_ok">同意并申请</string>
    <string name="permission_grant_cancel">暂不申请（只检测当前 WiFi）</string>
    <string name="permission_not_shown">尚未申请 WiFi 权限：列表可能为空，可点下方按钮先查看权限用途说明</string>
    <string name="degraded_prefix">当前处于降级状态</string>
    <string name="degraded_no_list">权限被拒：仅检测当前连接的 WiFi，不显示周边列表</string>

    <!-- 元素 7：保存 -->
    <string name="btn_save">保存账号与 WiFi 绑定</string>
    <string name="save_done">已保存：%1$s ↔ %2$s</string>

    <!-- 元素 8：状态区 -->
    <string name="status_initial">尚未登录</string>

    <!-- 元素 9：立即登录 -->
    <string name="btn_login_now">立即登录</string>

    <!-- 元素 10：Portal（门户）地址（不同校区地址不同，可自行输入并保存） -->
    <string name="label_portal">Portal 地址（校园网门户，按校区填写）</string>
    <string name="hint_portal">如 202.194.116.116（可带 http:// 前缀）</string>
    <string name="btn_save_portal">保存 Portal 地址</string>
    <string name="save_portal_done">已保存 Portal 地址：%1$s</string>
</resources>
